{
  "name": "verdant-ecommerce-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build:frontend && node backend/server.js",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:frontend",
    "lint": "node --check backend/server.js",
    "start": "node backend/server.js",
    "seed": "npm run seed --workspace=backend",
    "test": "node --test tests/api.test.js",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "multer": "^2.4.0"
  }
}
