# ========================================================
# Vishal Jewellery Store — Environment Configuration Template
# ========================================================
# Duplicate this file as `.env` and provide your actual values.
# NEVER commit your real `.env` file to version control.
# In production (Render, Railway, Vercel, AWS), set these as Environment Secrets.

# --------------------------------------------------------
# Server & Client Configuration
# --------------------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --------------------------------------------------------
# Database Connection (MongoDB Atlas or Local MongoDB)
# --------------------------------------------------------
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vishal_jewellery?retryWrites=true&w=majority
# If left blank or unreachable, the system automatically falls back to the in-memory mock store.
MONGO_URI=mongodb://localhost:27017/vishal_jewellery

# --------------------------------------------------------
# Authentication (JWT)
# --------------------------------------------------------
# Generate a strong 64-byte random secret: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# Cloud Media Storage (Cloudinary)
# --------------------------------------------------------
# Sign up at https://cloudinary.com (free tier available)
# Obtain credentials from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=vishal-jewellery-products

# Note: If Cloudinary credentials are not provided, image uploads
# will safely fall back to local disk storage in `uploads/`.

# --------------------------------------------------------
# Remote Backend Proxy (Optional)
# --------------------------------------------------------
# If you deploy a separate microservice backend or Vercel API, set its URL below:
# BACKEND_URL=https://your-backend.example.com
# VITE_BACKEND_URL=https://your-backend.example.com
